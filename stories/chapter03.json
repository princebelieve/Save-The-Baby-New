      "scene_id": "chapter03",
      "stage_direction": "Rain, interrupted sleep and a missing infant. Preserve the distinction between Amara's true sighting and the unexplained means of entry.",
      "dialogues": [
        {
          "speaker": "Amara",
          "portrait": "res://assets/sprites/characters/amara_and_ethan_portrait_cutout.png",
          "text": "I used to sell breakfast before sunrise, then deliver parcels after lunch."
        },
        {
          "speaker": "David",
          "portrait": "res://assets/sprites/characters/david_portrait_v2.png",
          "text": "Was Victor working with you?"
        },
        {
          "speaker": "Amara",
          "portrait": "res://assets/sprites/characters/amara_and_ethan_portrait_cutout.png",
          "text": "He said his aura brought the customers. Once I bought him shoes and he thanked his luck."
        },
        {
          "speaker": "David",
          "portrait": "res://assets/sprites/characters/david_portrait_v2.png",
          "text": "Not you?"
        },
        {
          "speaker": "Amara",
          "portrait": "res://assets/sprites/characters/amara_and_ethan_portrait_cutout.png",
          "text": "I kept waiting for it. I don't know why that is the part I remember now."
        }
      ],
      "choices": []
    }
  ],
