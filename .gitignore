# Godot 4+ specific ignores
.godot/
/android/
/build/
/.test-data/
/.gradle-cache/

# Generated Python bytecode from local release tools.
__pycache__/
*.py[cod]

/.tmp/
/.private/
/exports/marketing-v9/

/server/node_modules/
**/.env
**/.env.*
!**/.env.example

# Private Google credential downloads must never be committed.
**/client_secret*.json
**/*service-account*.json
**/*service_account*.json
**/save-the-baby-513514-*.json
