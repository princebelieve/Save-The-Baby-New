[gd_resource type="Theme" load_steps=7 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Baloo2-Variable.ttf" id="1_font"]
[ext_resource type="Texture2D" path="res://assets/sprites/ui/icons/toggle_on.svg" id="2_on"]
[ext_resource type="Texture2D" path="res://assets/sprites/ui/icons/toggle_off.svg" id="3_off"]
[ext_resource type="Texture2D" path="res://assets/sprites/ui/icons/slider_grip.svg" id="4_grip"]

[sub_resource type="StyleBoxFlat" id="Track"]
bg_color = Color(0.66, 0.73, 0.81, 1)
content_margin_top = 6.0
content_margin_bottom = 6.0
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="StyleBoxFlat" id="Fill"]
bg_color = Color(0.086, 0.545, 0.624, 1)
content_margin_top = 6.0
content_margin_bottom = 6.0
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[resource]
default_font = ExtResource("1_font")
default_font_size = 22

Button/font_sizes/font_size = 32
OptionButton/font_sizes/font_size = 32
PopupMenu/font_sizes/font_size = 32
LineEdit/font_sizes/font_size = 32
CheckButton/font_sizes/font_size = 32
CheckButton/icons/checked = ExtResource("2_on")
CheckButton/icons/unchecked = ExtResource("3_off")
CheckButton/icons/checked_disabled = ExtResource("2_on")
CheckButton/icons/unchecked_disabled = ExtResource("3_off")
HSlider/icons/grabber = ExtResource("4_grip")
HSlider/icons/grabber_highlight = ExtResource("4_grip")
HSlider/styles/slider = SubResource("Track")
HSlider/styles/grabber_area = SubResource("Fill")
HSlider/styles/grabber_area_highlight = SubResource("Fill")
